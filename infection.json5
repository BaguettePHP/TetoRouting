{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.35.4/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "testFramework": "phpunit",
    "staticAnalysisTool": "phpstan",
    "phpUnit": {
        "customPath": "vendor-bin/phpunit/vendor/bin/phpunit"
    },
    "phpStan": {
        "customPath": "vendor-bin/tools/vendor/bin/phpstan"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true,

        // Removing this fast return falls through to the identical final return.
        "ReturnRemoval": {
            "ignore": [
                "Teto\\Routing\\Action::match::98"
            ]
        },

        // These mutations only enable or disable the static-segment prefilter.
        // Action::match() remains the authoritative matcher in every case.
        "GreaterThan": {
            "ignore": [
                "Teto\\Routing\\Router::match::95"
            ]
        },
        "GreaterThanNegotiation": {
            "ignore": [
                "Teto\\Routing\\Router::match::95"
            ]
        },
        "LogicalAndAllSubExprNegation": {
            "ignore": [
                "Teto\\Routing\\Router::match::97",
                "Teto\\Routing\\Router::match::99"
            ]
        },
        "LogicalAndSingleSubExprNegation": {
            "ignore": [
                "Teto\\Routing\\Router::match::97"
            ]
        },
        "DecrementInteger": {
            "ignore": [
                "Teto\\Routing\\Router::match::100"
            ]
        },
        "Continue_": {
            "ignore": [
                "Teto\\Routing\\Router::match::100"
            ]
        }
    }
}
