{
    "name": "zonuexe/simple-routing",
    "description": "Simple Web Application Router",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "USAMI Kenta",
            "email": "tadsan@zonu.me"
        }
    ],
    "keywords": [
        "router"
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Teto\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teto\\Routing\\": "tests/"
        }
    },
    "scripts": {
        "ecs": "vendor-bin/tools/vendor/bin/ecs check",
        "infection": "vendor-bin/infection/vendor/bin/infection run --no-progress",
        "phpstan": "vendor-bin/tools/vendor/bin/phpstan",
        "test": "vendor-bin/phpunit/vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        }
    }
}
